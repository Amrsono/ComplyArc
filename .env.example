# ============================================
# ComplyArc — Environment Configuration
# ============================================

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql+asyncpg://complyarc:complyarc_secret@localhost:5432/complyarc
DATABASE_URL_SYNC=postgresql://complyarc:complyarc_secret@localhost:5432/complyarc
POSTGRES_URL=postgresql://complyarc:complyarc_secret@localhost:5432/complyarc

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# API Keys
API_KEY_HEADER=X-API-Key

# OpenAI (for adverse media AI NLP analysis)
OPENAI_API_KEY=sk-your-openai-api-key

# News API (for adverse media monitoring)
NEWS_API_KEY=your-news-api-key

# CORS & Network Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Environment & Cloud Platform Flags
ENVIRONMENT=development
DEBUG=true
VERCEL=0
